              "const tarihOk = (d) => /^\\d{2}-\\d{2}-\\d{4}$/.test(d);",
              "const list = pm.response.json();",
              "pm.test(\"en az 6 kayıt\", () => pm.expect(list.length).to.be.at.least(6));",
              "pm.test(\"tarihler GG-AA-YYYY\", () => list.forEach((e) => pm.expect(tarihOk(e.date), e.date).to.be.true));",
              "pm.test(\"_id ve createdAt var\", () => pm.expect(list[0]).to.have.property(\"_id\") && pm.expect(list[0]).to.have.property(\"createdAt\"));",
              "pm.collectionVariables.set(\"eventId\", list[0]._id);",
              "pm.collectionVariables.set(\"toplam\", list.length);"
